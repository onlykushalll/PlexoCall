# Environment template for an owner-operated API deployment. This file is not
# loaded by the local development Compose stack; never commit real credentials.
NODE_ENV=production
PORT=8787
DATABASE_URL=postgres://plexocall:replace-with-a-unique-password@database:5432/plexocall
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=wss://media.example.net
LIVEKIT_API_KEY=replace-with-at-least-16-random-characters
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
# Comma-separated exact proxy IPs/CIDRs. Leave empty if the API is not behind a proxy.
TRUST_PROXY=
